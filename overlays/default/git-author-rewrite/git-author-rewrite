#!/usr/bin/env bash

set -euo pipefail

if (($# != 3)); then
    printf 'Usage: %s <old-email> <correct-name> <correct-email>\n' "$0" >&2
    exit 1
fi

export OLD_EMAIL=$1
export CORRECT_NAME=$2
export CORRECT_EMAIL=$3

mapfile -t refs < <(git for-each-ref --format='%(refname)' refs/heads refs/tags)
if ((${#refs[@]} == 0)); then
    printf 'No local branches or tags found\n' >&2
    exit 1
fi

git filter-repo --force --refs "${refs[@]}" --commit-callback '
import os

old_email = os.environ["OLD_EMAIL"].encode()
correct_name = os.environ["CORRECT_NAME"].encode()
correct_email = os.environ["CORRECT_EMAIL"].encode()

if commit.committer_email == old_email:
    commit.committer_name = correct_name
    commit.committer_email = correct_email

if commit.author_email == old_email:
    commit.author_name = correct_name
    commit.author_email = correct_email
'
